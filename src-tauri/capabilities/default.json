{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://open.feishu.cn/**" },
        { "url": "https://**" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "exec-zsh", "cmd": "zsh", "args": true },
        { "name": "exec-sh", "cmd": "sh", "args": true },
        { "name": "exec-bash", "cmd": "bash", "args": true },
        { "name": "binaries/openclaw", "sidecar": true, "args": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "exec-zsh", "cmd": "zsh", "args": true },
        { "name": "exec-sh", "cmd": "sh", "args": true },
        { "name": "exec-bash", "cmd": "bash", "args": true },
        { "name": "binaries/openclaw", "sidecar": true, "args": true }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$HOME/.clawsetup" },
        { "path": "$HOME/.clawsetup/**" },
        { "path": "$HOME/.openclaw" },
        { "path": "$HOME/.openclaw/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/.clawsetup" },
        { "path": "$HOME/.clawsetup/**" },
        { "path": "$HOME/.openclaw" },
        { "path": "$HOME/.openclaw/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$HOME/.clawsetup" },
        { "path": "$HOME/.clawsetup/**" },
        { "path": "$HOME/.openclaw" },
        { "path": "$HOME/.openclaw/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/.clawsetup" },
        { "path": "$HOME/.clawsetup/**" },
        { "path": "$HOME/.openclaw" },
        { "path": "$HOME/.openclaw/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME/.clawsetup" },
        { "path": "$HOME/.clawsetup/**" },
        { "path": "$HOME/.openclaw" },
        { "path": "$HOME/.openclaw/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$HOME/.clawsetup" },
        { "path": "$HOME/.clawsetup/**" },
        { "path": "$HOME/.openclaw" },
        { "path": "$HOME/.openclaw/**" }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        { "path": "$HOME/.clawsetup" },
        { "path": "$HOME/.clawsetup/**" },
        { "path": "$HOME/.openclaw" },
        { "path": "$HOME/.openclaw/**" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$HOME/.clawsetup" },
        { "path": "$HOME/.clawsetup/**" },
        { "path": "$HOME/.openclaw" },
        { "path": "$HOME/.openclaw/**" }
      ]
    }
  ]
}
